<Window x:Class="AudioRouter.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="声桥启动器" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}" Background="{DynamicResource PanelBrush}">
    <StackPanel Margin="32,26,32,30">
        <StackPanel Orientation="Horizontal">
            <Border Width="44" Height="44" Background="{DynamicResource AccentBrush}" CornerRadius="10">
                <Path Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0,7 L 0,14 M 6,2 L 6,19 M 12,5 L 12,16 M 18,0 L 18,21"/>
            </Border>
            <TextBlock Text="声桥" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>
        <TextBlock Margin="0,19,0,20" Foreground="{DynamicResource MutedBrush}" Text="将应用声音送到耳机、音响和游戏麦克风。"/>
        <Button Style="{StaticResource PrimaryButton}" Click="OpenMixer_Click" IsDefault="True">打开调音台</Button>
        <Button Margin="0,8,0,0" Click="CheckInput_Click">检查游戏麦</Button>
    </StackPanel>
</Window>
